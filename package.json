  "license": "MIT",
  "author": "Nate Feldmann",
  "homepage": "https://github.com/feldmannn/webcash-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feldmannn/webcash-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/feldmannn/webcash-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webcash",
    "x402",
    "agent-payments",
    "claude"
  ],
  "type": "module",
  "main": "dist/server.js",
  "bin": {
