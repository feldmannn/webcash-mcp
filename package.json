{
  "name": "webcash-mcp",
  "version": "0.2.2",
  "description": "MCP server that lets AI agents pay any HTTP 402 / x402-webcash endpoint using bearer e-cash from a local wallet.",
  "license": "MIT",
  "author": "Nate Feldmann",
  "homepage": "https://github.com/feldmannn/webcash-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feldmannn/webcash-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/feldmannn/webcash-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webcash",
    "x402",
    "agent-payments",
    "claude"
  ],
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "webcash-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx tests/wallet-tools.test.ts tests/pay-fetch.test.ts tests/pay-tool.test.ts tests/dialect-alignment.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "x402-webcash": "^0.5.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0",
    "@feldmannn/x402-mcp": "^0.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
